NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/aramik

# Signs and verifies user session tokens (see src/modules/auth). Generate a real
# secret for every deployed environment, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-value

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

ELEVENLABS_API_KEY=xxxxxxxx

REVENUECAT_API_KEY=xxxxxxxx

# The server region must be eu-central (Frankfurt) - GDPR simplicity requirement
DEPLOYMENT_REGION=eu-central-1
